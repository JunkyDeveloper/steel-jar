<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>steel</groupId>
  <artifactId>steel-jar</artifactId>
  <version>0.16.0+mc26.3</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <steel.release>https://github.com/Steel-Foundation/SteelMC/releases/download/v0.16.0%2Bmc26.3</steel.release>
  </properties>

  <build>
    <finalName>steel</finalName>
    <plugins>
      <!-- fetch every release binary into the jar, verified by sha256 -->
      <plugin>
        <groupId>io.github.download-maven-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>2.0.0</version>
        <executions>
          <execution>
            <id>steel-linux</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-linux</url>
              <sha256>9c9c0a7f1123a9bf9f216a534394d3f0b224a56175785a62ea51cf439daa3072</sha256>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>steel-linux-musl</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-linux-musl</url>
              <sha256>7b86cb7cf21db37457d354b737c156e3b55a5671a665a31effbeb44115462c60</sha256>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>steel-macos</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-macos</url>
              <sha256>9e260d1407e4bf56bdbaab2bef3256eccd0e5325ddb33a935e57b8f827906259</sha256>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>steel-windows</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-windows.exe</url>
              <sha256>bd0314a86cc95b7a0b2e700127ce227a3b444c7c788d57d35ae6c3fa939cecd5</sha256>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>steel.Launcher</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
