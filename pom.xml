<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>steel</groupId>
  <artifactId>steel-jar</artifactId>
  <version>0.17.0+mc26.3</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <steel.release>https://github.com/Steel-Foundation/SteelMC/releases/download/v${project.version}</steel.release>
  </properties>

  <build>
    <finalName>steel</finalName>
    <plugins>
      <!-- fetch every binary of the SteelMC release matching project.version into the jar (unverified: no fixed sha256; skipCache so a new release is picked up) -->
      <plugin>
        <groupId>io.github.download-maven-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>2.0.0</version>
        <executions>
          <execution>
            <id>steel-linux</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-linux</url>
              <skipCache>true</skipCache>
              <overwrite>true</overwrite>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>steel-linux-musl</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-linux-musl</url>
              <skipCache>true</skipCache>
              <overwrite>true</overwrite>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>steel-macos</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-macos</url>
              <skipCache>true</skipCache>
              <overwrite>true</overwrite>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>steel-windows</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <url>${steel.release}/steel-windows.exe</url>
              <skipCache>true</skipCache>
              <overwrite>true</overwrite>
              <outputDirectory>${project.build.outputDirectory}/bin</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>steel.Launcher</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
